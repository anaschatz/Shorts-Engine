{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shortsengine.local/contracts/node-python/v1/protocol.schema.json",
  "title": "ShortsEngine Node/Python worker protocol v1",
  "description": "Path-free contracts. Artifact IDs are resolved by the owning runtime, never by the payload.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "sha256"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "candidateId",
        "sourceArtifactId",
        "startMs",
        "endMs",
        "contentType",
        "rankingScore",
        "evidence"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "candidateId": {"$ref": "#/$defs/id"},
        "sourceArtifactId": {"$ref": "#/$defs/id"},
        "startMs": {"type": "integer", "minimum": 0},
        "endMs": {"type": "integer", "minimum": 1},
        "contentType": {
          "enum": ["football", "motivational", "narrated_animation"]
        },
        "rankingScore": {"type": "number", "minimum": 0, "maximum": 100},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/reasonCode"}
        },
        "extensions": {"type": "object"}
      }
    },
    "hookGateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "candidateId",
        "gateVersion",
        "decision",
        "reasonCodes",
        "metrics"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "candidateId": {"$ref": "#/$defs/id"},
        "gateVersion": {"enum": ["hook-gate-v2", "hook-gate-v3"]},
        "decision": {"enum": ["pass", "reject", "human_review"]},
        "reasonCodes": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/reasonCode"}
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundaryCompleteness",
            "captionReadability",
            "visualSubjectCoverage"
          ],
          "properties": {
            "boundaryCompleteness": {"type": "number", "minimum": 0, "maximum": 100},
            "captionReadability": {"type": "number", "minimum": 0, "maximum": 100},
            "visualSubjectCoverage": {"type": "number", "minimum": 0, "maximum": 100},
            "latencyMs": {"type": "integer", "minimum": 0},
            "estimatedCostUsd": {"type": "number", "minimum": 0}
          }
        },
        "extensions": {"type": "object"}
      }
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "artifactId", "kind", "sha256", "sizeBytes"],
      "properties": {
        "schemaVersion": {"const": 1},
        "artifactId": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": ["source", "transcript", "analysis", "preview", "render", "qa"]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mimeType"],
          "properties": {
            "mimeType": {
              "type": "string",
              "pattern": "^(video|audio|application)/[a-z0-9.+-]{1,64}$"
            },
            "durationMs": {"type": "integer", "minimum": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "extensions": {"type": "object"}
      }
    },
    "analysisRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "operation", "source", "options"],
      "properties": {
        "schemaVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/id"},
        "operation": {"const": "analysis"},
        "source": {"$ref": "#/$defs/sourceReference"},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentType", "language", "maxCandidates"],
          "properties": {
            "contentType": {
              "enum": ["football", "motivational", "narrated_animation"]
            },
            "language": {
              "type": "string",
              "pattern": "^(auto|[a-z]{2,3}(-[a-z0-9]{2,8})?)$"
            },
            "maxCandidates": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "extensions": {"type": "object"}
      }
    },
    "analysisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "status",
        "candidates",
        "hookGate"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/id"},
        "operation": {"const": "analysis"},
        "status": {"const": "succeeded"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "hookGate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/hookGateDecision"}
        },
        "artifact": {"$ref": "#/$defs/artifactManifest"},
        "extensions": {"type": "object"}
      }
    },
    "renderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "source",
        "candidate",
        "hookGate",
        "profile"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/id"},
        "operation": {"const": "render"},
        "source": {"$ref": "#/$defs/sourceReference"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "hookGate": {"$ref": "#/$defs/hookGateDecision"},
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formatProfile", "selectionProfile", "renderProfile"],
          "properties": {
            "formatProfile": {"$ref": "#/$defs/id"},
            "selectionProfile": {"$ref": "#/$defs/id"},
            "renderProfile": {"$ref": "#/$defs/id"}
          }
        },
        "extensions": {"type": "object"}
      }
    },
    "renderResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "operation", "status", "artifact", "qa"],
      "properties": {
        "schemaVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/id"},
        "operation": {"const": "render"},
        "status": {"const": "succeeded"},
        "artifact": {"$ref": "#/$defs/artifactManifest"},
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "codes"],
          "properties": {
            "passed": {"const": true},
            "codes": {
              "type": "array",
              "maxItems": 32,
              "items": {"$ref": "#/$defs/reasonCode"}
            }
          }
        },
        "extensions": {"type": "object"}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "status", "error"],
      "properties": {
        "schemaVersion": {"const": 1},
        "requestId": {"$ref": "#/$defs/id"},
        "status": {"const": "error"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"$ref": "#/$defs/reasonCode"},
            "message": {"type": "string", "minLength": 1, "maxLength": 240},
            "retryable": {"type": "boolean"},
            "field": {"$ref": "#/$defs/id"}
          }
        },
        "extensions": {"type": "object"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/analysisRequest"},
    {"$ref": "#/$defs/analysisResult"},
    {"$ref": "#/$defs/renderRequest"},
    {"$ref": "#/$defs/renderResult"},
    {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/hookGateDecision"},
    {"$ref": "#/$defs/artifactManifest"},
    {"$ref": "#/$defs/errorResponse"}
  ]
}
